<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="003-create-sync-jobs-table" author="dev">
        <createTable tableName="sync_jobs" schemaName="integration">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="system_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_sync_jobs_system"
                             references="integration.external_systems(id)"/>
            </column>
            <column name="resource_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="records_processed" type="INTEGER"/>
            <column name="error_message" type="TEXT"/>
            <column name="started_at" type="TIMESTAMP"/>
            <column name="completed_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_sync_jobs_system_id" tableName="sync_jobs" schemaName="integration">
            <column name="system_id"/>
        </createIndex>
        <createIndex indexName="idx_sync_jobs_status" tableName="sync_jobs" schemaName="integration">
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
