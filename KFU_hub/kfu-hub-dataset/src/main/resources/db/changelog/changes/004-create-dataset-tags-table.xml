<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="004-create-dataset-tags-table" author="dev">
        <createTable tableName="dataset_tags" schemaName="datasets">
            <column name="dataset_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_dataset_tags_dataset"
                             references="datasets.datasets(id)"/>
            </column>
            <column name="tag" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="dataset_tags" schemaName="datasets"
                       columnNames="dataset_id, tag"
                       constraintName="pk_dataset_tags"/>

        <createIndex indexName="idx_dataset_tags_tag" tableName="dataset_tags" schemaName="datasets">
            <column name="tag"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
