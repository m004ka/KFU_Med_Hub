<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="002-create-analysis-tasks-table" author="dev">
        <createTable tableName="analysis_tasks" schemaName="ai">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="task_type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="QUEUED">
                <constraints nullable="false"/>
            </column>
            <column name="model_name" type="VARCHAR(255)"/>
            <column name="input_ref" type="VARCHAR(512)"/>
            <column name="output_ref" type="VARCHAR(512)"/>
            <column name="result_json" type="TEXT"/>
            <column name="error_message" type="TEXT"/>
            <column name="progress" type="INTEGER" defaultValueNumeric="0"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="completed_at" type="TIMESTAMP"/>
        </createTable>

        <createIndex indexName="idx_analysis_tasks_user_id" tableName="analysis_tasks" schemaName="ai">
            <column name="user_id"/>
        </createIndex>
        <createIndex indexName="idx_analysis_tasks_status" tableName="analysis_tasks" schemaName="ai">
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
