<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="002-create-audit-logs-table" author="dev">
        <createTable tableName="audit_logs" schemaName="audit">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="UUID"/>
            <column name="user_name" type="VARCHAR(255)"/>
            <column name="action" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="entity_type" type="VARCHAR(100)"/>
            <column name="entity_id" type="VARCHAR(255)"/>
            <column name="details" type="TEXT"/>
            <column name="ip_address" type="VARCHAR(45)"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_audit_logs_user_id" tableName="audit_logs" schemaName="audit">
            <column name="user_id"/>
        </createIndex>
        <createIndex indexName="idx_audit_logs_entity" tableName="audit_logs" schemaName="audit">
            <column name="entity_type"/>
            <column name="entity_id"/>
        </createIndex>
        <createIndex indexName="idx_audit_logs_created_at" tableName="audit_logs" schemaName="audit">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
