<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="004-create-tasks-table" author="dev">
        <createTable tableName="tasks" schemaName="projects">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="project_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_tasks_project"
                             references="projects.projects(id)"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="status" type="VARCHAR(20)" defaultValue="TODO">
                <constraints nullable="false"/>
            </column>
            <column name="priority" type="VARCHAR(20)" defaultValue="MEDIUM">
                <constraints nullable="false"/>
            </column>
            <column name="assignee_id" type="UUID"/>
            <column name="assignee_name" type="VARCHAR(255)"/>
            <column name="due_date" type="DATE"/>
            <column name="position" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_tasks_project_id" tableName="tasks" schemaName="projects">
            <column name="project_id"/>
        </createIndex>
        <createIndex indexName="idx_tasks_assignee_id" tableName="tasks" schemaName="projects">
            <column name="assignee_id"/>
        </createIndex>
        <createIndex indexName="idx_tasks_status" tableName="tasks" schemaName="projects">
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
